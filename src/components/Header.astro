---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

// « Offres » reste actif sur les pages /offres et /maintenance.
const offersActive = /^\/(offres|maintenance)(\/|$)/.test(Astro.url.pathname);
---

<header class="site-header">
	<div class="site-container header-inner">
		<!-- Le nom lu par les lecteurs d'écran reprend le texte visible (WCAG 2.5.3) ; le logo est décoratif. -->
		<a class="brand" href="/" aria-label={`${SITE_TITLE}, retour à l'accueil`}>
			<picture>
				<source type="image/webp" srcset="/assets/brand/logo-medallion-sm.webp 1x, /assets/brand/logo-medallion-sm@2x.webp 2x" />
				<img src="/assets/brand/logo-medallion-sm.png" srcset="/assets/brand/logo-medallion-sm.png 1x, /assets/brand/logo-medallion-sm@2x.png 2x" width="52" height="52" alt="" />
			</picture>
			<span class="brand-wordmark"><span class="brand-wordmark-prefix">Z&amp;L</span> <strong>ScaleTech</strong></span>
		</a>

		<nav class="main-nav" aria-label="Navigation principale">
			<HeaderLink href="/">Accueil</HeaderLink>
			<!--
				Sous-menu Offres, sans JavaScript :
				- écrans avec souris : lien vers /offres, menu ouvert au survol ou au focus clavier ;
				- écrans tactiles : bouton <details> qui ouvre / ferme le menu au toucher.
			-->
			<div class="nav-dropdown">
				<HeaderLink href="/offres" class={offersActive ? 'active' : undefined}>Offres <svg class="nav-dropdown__chevron" aria-hidden="true" viewBox="0 0 12 12" width="10" height="10"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></HeaderLink>
				<details class="nav-dropdown__toggle">
					<summary class:list={[{ active: offersActive }]}>Offres <svg class="nav-dropdown__chevron" aria-hidden="true" viewBox="0 0 12 12" width="10" height="10"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
				</details>
				<ul class="nav-dropdown__menu">
					<li>
						<a href="/offres">
							<strong>Création de site</strong>
							<span>Vitrine, e-commerce, sur mesure</span>
						</a>
					</li>
					<li>
						<a href="/maintenance">
							<strong>Maintenance</strong>
							<span>Suivi après la livraison</span>
						</a>
					</li>
				</ul>
			</div>
			<HeaderLink href="/a-propos">À propos</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</nav>

		<a class="button button--primary header-cta" href="/contact">Demander un devis</a>
	</div>
</header>
